<div class="page-container">
  <div class="space-y-2 mb-2">
    <h1 class="text-primary"><%= @user.name %> 的任務</h1>

    <%= link_to "返回使用者列表", admin_users_path, class: "btn-primary" %>
    <%= link_to "編輯", edit_admin_user_path, class: "btn-primary" %>

    <div class="user-info">
        <p><strong>Email:</strong> <%= @user.email %></p>
        <p><strong>權限:</strong> <%= @user.admin? ? "管理員" : "一般使用者" %></p>
        <p><strong>任務總數:</strong> <%= @user.tasks.size %></p>
    </div>
  </div>

  <hr>

  <h2>任務列表</h2>

  <table class="table">
    <thead>
      <tr>
        <th>標題</th>
        <th>內容摘要</th>
        <th>開始時間</th>
        <th>結束時間</th>
        <th>狀態</th>
        <th>優先度</th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.title %></td>
          <td><%= truncate(task.content, length: 30) %></td> <%# 使用 truncate 避免內容太長撐開表格 %>
          <td><%= task.start_at&.strftime("%Y-%m- %d %H:%M") %></td>
          <td><%= task.end_at&.strftime("%Y-%m-%d %H:%M") %></td>
          <td>
            <span class="status-tag <%= task.status %>">
              <%= task.status %>
            </span>
          </td>
          <td>
            <span class="priority-tag <%= task.priority %>">
              <%= task.priority %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>
</div>


<%= render "shared/pagination" %>