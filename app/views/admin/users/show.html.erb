<div class="page-container">
  <div class="space-y-2 mb-2">
    <%= link_to t('common.return'), admin_users_path, class: "btn-primary" %>
    <%= link_to t('common.edit'), edit_admin_user_path, class: "btn-primary" %>

    <h1 class="text-primary"><%= @user.name %></h1>
    <div class="user-info">
        <p><strong><%= User.human_attribute_name(:email) %>:</strong> <%= @user.email %></p>
        <p><strong><%= User.human_attribute_name(:admin) %>:</strong> <%= @user.admin? ? t('admin.users.index.right_admin') : t('admin.users.index.right_user') %></p>
        <p><strong><%= t('admin.users.index.task_amount') %>:</strong> <%= @user.tasks.size %></p>
    </div>
  </div>

  <hr>

  <h2><%= t('tasks.index.title') %></h2>

  <table class="table">
    <thead>
      <tr>
        <th><%= Task.human_attribute_name(:title) %></th>
        <th><%= Task.human_attribute_name(:content) %></th>
        <th><%= Task.human_attribute_name(:start_at) %></th>
        <th><%= Task.human_attribute_name(:end_at) %></th>
        <th><%= Task.human_attribute_name(:status) %></th>
        <th><%= Task.human_attribute_name(:priority) %></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.title %></td>
          <td><%= truncate(task.content, length: 30) %></td> <%# 使用 truncate 避免內容太長撐開表格 %>
          <td><%= task.start_at&.strftime("%Y-%m- %d %H:%M") %></td>
          <td><%= task.end_at&.strftime("%Y-%m-%d %H:%M") %></td>
          <td>
            <span class="status-tag <%= task.status %>">
              <%= task.status %>
            </span>
          </td>
          <td>
            <span class="priority-tag <%= task.priority %>">
              <%= task.priority %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>
</div>


<%= render "shared/pagination" %>