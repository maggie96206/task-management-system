<div class="w-full h-full flex flex-col py-5 px-20 items-center">

    <%= form_with(model: [:admin, user], local: true) do |f| %>
        <div class="flex flex-col gap-4">
            <div>
                <%= f.label :name %>
                <%= f.text_field :name, class: "input_box" %>
            </div>

            <div>
                <%= f.label :email %>
                <%= f.email_field :email, class: "input_box" %>
            </div>

            <div>
                <%= f.label :password, "密碼 (如不修改請留白)" %>
                <%= f.password_field :password, class: "input_box" %>
            </div>

            <div>
                <%= f.label :admin, "設為管理員" %>
                <%= f.check_box :admin, class: "input_box" %>
            </div>

            <div class="w-full flex flex-row gap-x-4 justify-center">
                <%= f.submit t('common.submit'), class: "btn-primary" %>
                <%= link_to t('common.quit'), admin_users_path, class: "btn-primary" %>
            </div>
        </div>
    <% end %>

</div>