<div class="w-full h-full flex flex-col py-5 px-20 items-center">
    <%= form_with(model: @tag, class: "space-y-6 max-w-lg") do |f| %>
        <% if @tag.errors.any? %>
            <div class="text-red-500">
            <ul><% @tag.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
            </div>
        <% end %>
      
      <div class="flex flex-col">
        <%= f.label :name, class: "text-secondary" %>
        <%= f.text_field :name, class: "input", autofocus: true %>
      </div>

      <div class="w-full flex flex-row gap-x-4 justify-center">
        <%= f.submit t('common.submit'), class: "btn-primary" %>
        <%= link_to t('common.quit'), tags_path, class: "btn-primary"%>
      </div>

    <% end %>
</div>