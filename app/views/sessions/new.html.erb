<div class="w-full h-full flex flex-col py-5 px-20 items-center">
  <h1 class="text-2xl font-bold mb-4"><%= t("common.log_in") %></h1>

  <%= form_with(scope: :session, url: login_path, local: true, class: "space-y-6 w-full max-w-lg") do |f| %>
    
    <div class="flex flex-col">
      <%= f.label :email, t("activerecord.attributes.user.email") ,class: "text-secondary" %>
      <%= f.email_field :email, class: "input" %> 
    </div>

    <div class="flex flex-col">
      <%= f.label :password, t("activerecord.attributes.user.password"), class: "text-secondary" %>
      <%= f.password_field :password, class: "input" %> 
    </div>

    <div class="w-full flex flex-row gap-x-4 justify-center">
      <%= f.submit t("common.log_in"), class: "btn-primary" %>
      <%= link_to t("common.quit"), root_path, class: "btn-primary" %>
    </div>
  <% end %>
</div>