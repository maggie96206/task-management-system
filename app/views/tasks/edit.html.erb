<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal" do %>
    <div class="modal-box">
      <button class="modal-close-btn" data-action="click->modal#close">&times;</button>
      <h1 class="text-primary mb-4"><%= t('tasks.index.edit_task') %></h1>
      <%= render "form", task: @task %>
    </div>
  <% end %>
<% else %>
  <div class="w-full flex flex-col items-center mt-5">
    <h1 class="text-primary"><%= t('tasks.index.edit_task') %></h1>
  </div>
  <%= render "form", task: @task %>
<% end %>
