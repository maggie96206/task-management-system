<h1 class="mb-4">任務詳情</h1>

<div class="space-y-6">
    <p>
    <strong>標題：</strong>
    <%= @task.title %>
    </p>

    <p>
    <strong>內容：</strong>
    <%= @task.content %>
    </p>

    <p>
    <strong>開始時間：</strong>
    <%= @task.start_at %>
    </p>

    <p>
    <strong>結束時間：</strong>
    <%= @task.end_at %>
    </p>

    <p>
    <strong>優先度：</strong>
    <%= @task.priority %>
    </p>

    <p>
    <strong>狀態：</strong>
    <%= @task.status %>
    </p>
</div>



<%= link_to "編輯此任務", edit_task_path(@task) , class: "btn-primary" %>
<%= link_to "返回列表", tasks_path , class: "btn-primary" %>
