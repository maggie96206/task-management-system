<h1 class="mb-4"><%= t('tasks.index.view_task') %></h1>

<div class="space-y-6">
    <p>
    <strong><%= t('activerecord.attributes.task.title') %>：</strong>
    <%= @task.title %>
    </p>

    <p>
    <strong><%= t('activerecord.attributes.task.content') %>：</strong>
    <%= @task.content %>
    </p>

    <p>
    <strong><%= t('activerecord.attributes.task.start_at') %>：</strong>
    <%= @task.start_at %>
    </p>

    <p>
    <strong><%= t('activerecord.attributes.task.end_at') %>：</strong>
    <%= @task.end_at %>
    </p>

    <p>
    <strong><%= t('activerecord.attributes.task.priority') %>：</strong>
    <%= @task.priority %>
    </p>

    <p>
    <strong><%= t('activerecord.attributes.task.status') %>：</strong>
    <%= @task.status %>
    </p>
</div>



<%= link_to t('tasks.button.edit'), edit_task_path(@task) , class: "btn-primary" %>
<%= link_to t('tasks.button.return'), tasks_path , class: "btn-primary" %>
