<h1 class="mb-4"><%= t('tasks.index.title') %></h1>
<%= link_to "新增任務", new_task_path, class: "btn-primary" %>

<table>
  <thead>
    <tr>
      <th><%= t('activerecord.attributes.task.title') %></th>
      <th><%= t('activerecord.attributes.task.content') %></th>
      <th><%= t('activerecord.attributes.task.start_at') %></th>
      <th><%= t('activerecord.attributes.task.end_at') %></th>
      <th><%= t('activerecord.attributes.task.priority') %></th>
      <th><%= t('activerecord.attributes.task.status') %></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.start_at %></td>
        <td><%= task.end_at %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
        <td>
            <%= link_to t('tasks.button.view'), task_path(task), class: "btn-primary" %>
            <%= link_to t('tasks.button.edit'), edit_task_path(task), class: "btn-primary" %>
            <%= link_to t('tasks.button.delete'), task_path(task), data: { turbo_method: :delete, turbo_confirm: t('tasks.common.confirm_delete') }, class: "btn-primary" %>
        </td>
    </tr>
    <% end %>
  </tbody>
</table>
