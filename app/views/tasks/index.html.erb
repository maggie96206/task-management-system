<h1 class="mb-4">任務列表</h1>
<%= link_to "新增任務", new_task_path, class: "btn-primary" %>

<table>
  <thead>
    <tr>
      <th>標題</th>
      <th>內容</th>
      <th>開始時間</th>
      <th>結束時間</th>
      <th>優先度</th>
      <th>狀態</th>
      <th>動作</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.start_at %></td>
        <td><%= task.end_at %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
        <td>
            <%= link_to "檢視", task_path(task), class: "btn-primary" %>
            <%= link_to "編輯", edit_task_path(task), class: "btn-primary" %>
            <%= link_to "刪除", task_path(task), data: { turbo_method: :delete, turbo_confirm: "確定要刪除嗎？" }, class: "btn-primary" %>
        </td>
    </tr>
    <% end %>
  </tbody>
</table>
