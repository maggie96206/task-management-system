<div class="page-container">

  <div class="w-full flex flex-col items-center">
    <h1 class="text-primary"><%= t('.title') %></h1>

    <div class="w-full mb-4 flex">
      <%= link_to new_task_path, class: "flex items-center gap-2 px-6 py-2 border border-2 border-[#8585D8] text-[#8585D8] rounded-full font-bold hover:bg-[#8585D8] hover:text-white transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        
        <span><%= t('.new_task') %></span>
      <% end %>
    </div>

    <div class="w-full flex justify-between">
      <div class="sorting-links">
        <%= link_to t('.sort_created_at'), tasks_path, class: "btn-primary" %>
        <%= link_to t('.sort_end_at'), tasks_path(sort: "end_at"), class: "btn-primary" %>
        <%= link_to t('.sort_priority'), tasks_path(sort: "priority"), class: "btn-primary" %>
      </div>

      <%= form_with url: tasks_path, method: :get, local: true , class: "flex gap-4 items-center" do |f| %>
        <%= f.text_field :title, placeholder: t('.search_title'), class: "border border-[#4E4E9A] p-2 rounded-2xl", value: params[:title] %>

        <%= f.select :status, 
                    task_enum_options(:status), 
                    { include_blank: t('.search_status'), selected: params[:status] },
                    class: "block rounded-md sm:text-sm" %>

        <%= f.submit t('common.search'),
            class: "btn-primary" %>
      <% end %>
    </div>
  </div>
  

  

  <%# 任務卡片 %>
  <div class="mt-6">
    <% if @tasks.any? %>
      <%# 這行會自動對 @tasks 集合中的每個元素渲染 _task.html.erb %>
      <%= render @tasks %>
    <% else %>
      <div class="text-center py-20 text-gray-400">目前沒有任何任務</div>
    <% end %>
  </div>
</div>

<%# 分頁按鈕 %>
<%= render "pagination" %>

