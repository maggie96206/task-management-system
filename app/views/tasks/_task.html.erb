<div class="w-full bg-[#F0F0F7] rounded-3xl p-8 mb-6 shadow-sm border border-white">
  
  <%# 標題與按鈕 %>
  <div class="flex items-center justify-between mb-4">
    <h3 class="task-title text-2xl font-bold text-stroke"><%= task.title %></h3>
    
    <div class="flex gap-3">
      <%= link_to t('common.view'), task_path(task), class: "btn-secondary", data: { turbo_frame: "modal" } %>
      <%= link_to t('common.edit'), edit_task_path(task), class: "btn-secondary", data: { turbo_frame: "modal" } %>
      <%= link_to t('common.delete'), task_path(task), 
                  data: { turbo_method: :delete, turbo_confirm: t('common.confirm_delete') }, 
                  class: "btn-secondary" %>
    </div>
  </div>

  <%# 任務內容 %>
  <div class="text-gray-500 mb-8 line-clamp-2">
    <%= task.content %>
  </div>

  <%# 開始時間 結束時間 優先度 狀態 %>
  <div class="flex flex-wrap items-center gap-x-8 gap-y-4 text-stroke font-medium mb-6">
    
    <div class="flex items-center">
      <span class="border-l-4 border-stroke h-5 mr-3"></span>
      <span><%= Task.human_attribute_name(:start_at) %>：<%= task.start_at&.strftime("%Y/%m/%d %H:%M") %></span>
    </div>

    <div class="flex items-center">
      <span class="border-l-4 border-stroke h-5 mr-3"></span>
      <span><%= Task.human_attribute_name(:end_at) %>：<%= task.end_at&.strftime("%Y/%m/%d %H:%M") %></span>
    </div>

    <div class="flex items-center">
      <span class="border-l-4 border-stroke h-5 mr-3"></span>
      <span><%= Task.human_attribute_name(:priority) %>：<%= task.human_priority %></span>
    </div>

    <div class="flex items-center">
      <span class="border-l-4 border-stroke h-5 mr-3"></span>
      <span><%= Task.human_attribute_name(:status) %>：<%= task.human_status %></span>
    </div>

  </div>

  <% task.tags.each do |tag| %>
    <span class="tag"># <%= tag.name %></span>
  <% end %>

</div>